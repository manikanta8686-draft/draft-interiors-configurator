PORT=8787
DATABASE_PATH=data/configurations.sqlite
JSON_BODY_LIMIT=16kb
NODE_ENV=development
SERVE_CLIENT=false
# Set TRUST_PROXY=1 only when exactly one trusted reverse proxy sits in front of the app.
TRUST_PROXY=false
ENQUIRY_RECIPIENT_EMAIL=manikanta8686@draftinteriors.com
ENQUIRY_RETENTION_DAYS=90
BACKUP_DIRECTORY=server/backups
BACKUP_RETENTION_DAYS=30

# Admin dashboard. Generate the password hash with `npm --prefix server run admin:hash`.
# Use a random secret of at least 32 characters and HTTPS in production.
# ADMIN_EMAIL=admin@draftinteriors.com
# ADMIN_PASSWORD_HASH=scrypt$replace-with-generated-value
# ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# ADMIN_SECURE_COOKIES=false

# Add all SMTP settings in the deployment environment to enable email notifications.
# Never commit a real SMTP password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=manikanta8686@draftinteriors.com
# SMTP_PASSWORD=replace-with-smtp-password
# SMTP_FROM="Draft Interiors <manikanta8686@draftinteriors.com>"
